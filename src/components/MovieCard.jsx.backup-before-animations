
import { Link } from 'react-router-dom'
import { motion } from 'framer-motion'
import { Star, Clock, ArrowUpRight } from 'lucide-react'

export default function MovieCard({ movie, index = 0 }) {
  return (
    <motion.article
      initial={{ opacity: 0, y: 18 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, amount: 0.1 }}
      transition={{ duration: 0.35, delay: Math.min(index * 0.05, 0.25) }}
      className="movie-card group min-w-0 overflow-hidden rounded-2xl border border-white/[0.08] bg-[#131316]"
    >
      <Link to={`/movie/${movie.id}`} className="block">
        <div className="relative aspect-[3/4] overflow-hidden bg-zinc-900">
          <img
            src={movie.poster}
            alt={`${movie.title} movie poster`}
            loading="lazy"
            className="movie-poster h-full w-full object-cover"
            onError={(event) => {
              event.currentTarget.onerror = null
              event.currentTarget.src = 'https://placehold.co/400x600/18181b/f4f4f5?text=CINEORA'
            }}
          />
          <span className="absolute left-3 top-3 rounded-md border border-white/10 bg-black/70 px-2 py-1 text-xs">
            {movie.certificate}
          </span>
          <span className="absolute right-3 top-3 flex items-center gap-1 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-amber-400">
            <Star size={12} fill="currentColor" /> {movie.rating}
          </span>
          <span className="absolute inset-x-0 bottom-0 flex items-center justify-between bg-gradient-to-t from-black/95 to-transparent p-4 pt-12 text-sm font-semibold opacity-0 transition group-hover:opacity-100">
            View details <ArrowUpRight size={17} />
          </span>
        </div>
        <div className="p-4">
          <h3 className="truncate font-display text-lg font-semibold group-hover:text-rose-400">
            {movie.title}
          </h3>
          <p className="mt-1 text-xs text-zinc-500">{movie.genre} · {movie.language}</p>
          <div className="mt-4 flex items-center justify-between text-xs text-zinc-400">
            <span className="flex items-center gap-1"><Clock size={13} /> {movie.duration}</span>
            <span className="font-semibold text-zinc-200">From ₹{movie.price}</span>
          </div>
        </div>
      </Link>
    </motion.article>
  )
}
